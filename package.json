{
  "name": "subtitle-translator-extension",
  "version": "1.1.18",
  "description": "YouTube 字幕翻译 Chrome 扩展",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.js",
    "build:prod": "NODE_ENV=production node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:subtitle-fixture": "bun scripts/test-subtitle-fixture.ts",
    "build:verify": "bun run build && bun run test:subtitle-fixture"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^4.0.18"
  }
}
